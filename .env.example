# העתיקו לקובץ .env.local (שלא נכנס לגיט) ומלאו. אף ערך מכאן לא נשלח בצ'אט.
# זה פרויקט Supabase נפרד — לא של "הכסף של הבית".
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPER_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=

# ערכים ציבוריים לפיתוח מקומי (npm run dev) — אותם ערכים כמו למעלה:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# שלב 2ב — Supabase secrets (צד שרת), ראו SETUP.md §2:
# CRON_SECRET=              (הסוד שהתזמון שולח ל-storage-cleanup, בכותרת x-cron-secret)
# SB_PUBLISHABLE_KEY=       (רק אם ב-Edge אין SUPABASE_ANON_KEY בברירת מחדל — בפועל לא נדרש)

# שלבים הבאים — רק ב-Supabase secrets (צד שרת), לעולם לא בדפדפן:
# ANTHROPIC_API_KEY=        (מפתח נפרד לאפליקציה הזאת, עם תקרת הוצאה משלו)
# HF_API_KEY_ID=            (Higgsfield — רק בשלב 8, באישור אלעד)
# HF_API_KEY_SECRET=
# HIGGSFIELD_MODE=off       (off | fake | live)
# PEXELS_API_KEY=           (אופציונלי)
