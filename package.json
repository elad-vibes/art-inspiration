{
  "name": "art-inspiration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "check:functions": "node scripts/check-functions.mjs",
    "icons": "node scripts/icons.mjs",
    "lucide": "node scripts/lucide.mjs",
    "prepare": "git config core.hooksPath tools-git || true",
    "scan": "node scripts/precommit-scan.mjs --all"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "deno": "^2.9.6",
    "lucide-static": "^1.48.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2"
  }
}
